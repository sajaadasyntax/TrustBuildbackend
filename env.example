# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@your-neon-hostname.neon.tech/dbname?sslmode=require"

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# File uploads (profile/portfolio images) — stored on the server under /uploads by default.
# Set API_PUBLIC_URL in production so image URLs point at your API host (e.g. https://api.trustbuild.uk).
API_PUBLIC_URL=http://localhost:3000
#
# ⚠️  NGINX BODY SIZE — if nginx is your reverse proxy, add this to the server block or http block:
#     client_max_body_size 20m;
# Without this the default is 1MB and uploads over 1MB will fail with a 413 error.

# Cloudinary (optional — off unless CLOUDINARY_ENABLED=true)
CLOUDINARY_ENABLED=false
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email Configuration (Optional - for notifications)
# SendGrid API (Primary method - recommended for production)
SENDGRID_API_KEY=your-sendgrid-api-key

# Gmail SMTP (Fallback method)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email sender details
EMAIL_FROM=noreply@trustbuild.uk
EMAIL_FROM_NAME=TrustBuild

# Stripe Configuration (Optional - for payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Subscription Prices
STRIPE_PRICE_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_SIX_MONTHS=price_your-six-months-price-id
STRIPE_PRICE_YEARLY=price_your-yearly-price-id

# URLs for CORS configuration
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth Rate Limiting (separate from general rate limiting)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Development: Set DISABLE_RATE_LIMIT=true to disable all rate limiting in development mode
DISABLE_RATE_LIMIT=false

# File Upload Limits
MAX_FILE_SIZE=10485760
MAX_FILES_PER_UPLOAD=5

# Push Notifications (Web Push VAPID)
# Generate keys using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@trustbuild.uk 